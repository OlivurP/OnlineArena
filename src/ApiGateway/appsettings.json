{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" },
    "Console": { "FormatterName": "json", "FormatterOptions": { "IncludeScopes": true } }
  },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "online-arena-auth", "Audience": "online-arena", "Secret": "" },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "matchmaking": {
        "ClusterId": "matchmaking",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/matchmaking/{**catch-all}" }
      },
      "stats": {
        "ClusterId": "stats",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/stats/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "auth-1": { "Address": "http://auth:8080/" } } },
      "matchmaking": { "Destinations": { "matchmaking-1": { "Address": "http://matchmaking:8080/" } } },
      "stats": { "Destinations": { "stats-1": { "Address": "http://stats:8080/" } } }
    }
  }
}
